{
  "name": "@iec62443/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed/index.ts",
    "db:seed:demo-oil-gas": "tsx src/seed/demo-oil-gas.ts",
    "db:seed:demo-oil-gas-ot": "tsx src/seed/demo-oil-gas-ot.ts",
    "db:seed:demo-oil-gas-assessment": "tsx src/seed/demo-oil-gas-assessment.ts",
    "db:seed:demo-oil-gas-governance": "tsx src/seed/demo-oil-gas-governance.ts",
    "db:seed:demo-oil-gas-purdue": "tsx src/seed/demo-oil-gas-purdue.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@iec62443/shared-types": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.29.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0"
  }
}
