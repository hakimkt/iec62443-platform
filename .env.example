# IEC 62443 Platform — Local Development Environment
# Copy this file to .env and adjust values as needed

# Database
DATABASE_URL=postgresql://iec62443:iec62443_dev@localhost:5432/iec62443_platform

# Auth
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
LOG_LEVEL=debug

# MFA
MFA_ISSUER=IEC62443-Platform
