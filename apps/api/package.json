{
  "name": "@iec62443/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@iec62443/database": "workspace:*",
    "@iec62443/shared-types": "workspace:*",
    "@iec62443/shared-schemas": "workspace:*",
    "@iec62443/auth": "workspace:*",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "argon2": "^0.43.0",
    "fastify": "^5.3.3",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.0.2",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.44.0",
    "fastify-plugin": "^5.1.0",
    "handlebars": "^4.7.8",
    "jose": "^6.0.11",
    "nanoid": "^5.1.5",
    "nats": "^2.29.3",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.2",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.29.0",
    "testcontainers": "^11.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0"
  }
}
