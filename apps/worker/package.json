{
  "name": "@iec62443/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsup src/worker.ts --format esm",
    "start": "node dist/worker.js",
    "lint": "eslint . --max-warnings 0",
